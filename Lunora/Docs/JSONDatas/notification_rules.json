        "preferenceKey": "astrology",
        "requireMainNotificationsEnabled": true,
        "requireCategoryEnabled": true,
        "requireSystemPermission": true,
        "requireReadyDevice": true
      },
      "destination": {
        "type": "deep_link",
        "route": "astro_event_detail",
        "params": {
          "event": "mercury_retrograde"
        }
      },
      "notifications": [
        {
          "id": "mercury_retrograde_observation_30d",
          "enabled": true,
          "trigger": {
            "relativeTo": "event_start",
            "offsetDays": -30
          },
          "sendTime": "19:30",
          "stage": "observation",
          "priority": 40,
          "purpose": "Yaklaşan dönemi erken haber vermek",
          "content": {
            "title": "Merkür retrosu yaklaşıyor",
            "body": "İletişim, planlar ve günlük akışındaki tekrar eden küçük aksaklıkları şimdiden gözlemlemeye başla."
          }
        },
        {
          "id": "mercury_retrograde_prepare_14d",
          "enabled": true,
          "trigger": {
            "relativeTo": "event_start",
            "offsetDays": -14
          },
          "sendTime": "19:30",
          "stage": "prepare",
          "priority": 60,
          "purpose": "İletişim, teknoloji, randevu ve önemli planlarda hazırlık",
          "content": {
            "title": "Merkür retrosu hazırlıkları başlasın",
            "body": "Önemli randevuları, teknoloji işlerini ve iletişim gerektiren planlarını önceden düzenlemek işini kolaylaştırabilir."
