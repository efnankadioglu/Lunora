    {
      "id": "mercury_retrograde",
      "name": "Merkür Retrosu",
      "category": "astrology",
      "enabled": true,
      "source": {
        "dataset": "astro_data",
        "match": {
          "type": "planet_status",
          "planet": "mercury",
          "status": "retrograde"
        },
        "eventDateField": "start_at",
        "detectTransition": true
      },
      "planning": {
        "system": "scheduled",
        "timezone": "Europe/Istanbul",
        "generateAheadDays": 45
      },
