          "trigger": {
            "relativeTo": "event_start",
            "offsetDays": -7
          },
          "sendTime": "19:30",
          "stage": "checklist",
          "priority": 75,
          "purpose": "Eksikleri tamamlama ve kontroller",
          "content": {
            "title": "Merkür retrosuna 1 hafta kaldı",
            "body": "Yarım kalan işler, önemli mesajlar, rezervasyonlar ve planlar için son kontrollerini yap."
          }
        },
        {
          "id": "mercury_retrograde_last_check_1d",
          "enabled": true,
          "trigger": {
            "relativeTo": "event_start",
            "offsetDays": -1
          },
          "sendTime": "19:30",
          "stage": "last_check",
          "priority": 90,
          "purpose": "Son kontroller",
          "content": {
            "title": "Merkür retrosuna 1 gün kaldı",
            "body": "Bugün önemli konuşmaları, tarihleri ve planlarını bir kez daha kontrol etmek için iyi bir zaman."
